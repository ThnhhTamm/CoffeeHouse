@model List<CoffeeHouseAdmin.Models.CustomerAddress>

@{
    ViewData["Title"] = "Địa chỉ nhận hàng - Coffee House";
    Layout = "_Layout";
}

<div class="container mt-4 mb-5" style="max-width: 550px;">
    <div class="d-flex align-items-center mb-4">
        <a href="javascript:history.back()" class="text-dark me-3 fs-5">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h5 class="mb-0 fw-bold">Địa chỉ nhận hàng</h5>
    </div>

    <div class="address-container shadow-sm rounded-4 bg-white overflow-hidden">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <label class="address-item d-flex align-items-start p-3 border-bottom mb-0">
                    @* Nút Radio để chọn *@
                    <div class="pt-1">
                        <input class="form-check-input custom-radio" type="radio" name="selectedAddress" 
                               value="@item.AddressId" @(item.IsDefault ? "checked" : "")>
                    </div>
                    
                    <div class="ms-3 flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark">@item.ReceiverName | @item.PhoneNumber</span>
                            <a href="#" class="text-primary small text-decoration-none">Sửa</a>
                        </div>
                        <div class="text-muted small mb-2" style="line-height: 1.4;">
                            @item.AddressDetail
                        </div>
                        
                        @if (item.IsDefault)
                        {
                            <span class="badge-shopee">Mặc định</span>
                        }
                    </div>
                </label>
            }
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="fas fa-map-marked-alt fa-3x mb-3 opacity-25"></i>
                <p>Boss chưa có địa chỉ nào, thêm mới ngay nhé!</p>
            </div>
        }
    </div>

    <div class="mt-4">
       <button class="btn btn-outline-danger w-100 py-2 rounded-3 mb-3 d-flex align-items-center justify-content-center" 
        onclick="showAddAddressModal()">
    <i class="fas fa-plus-circle me-2"></i> Thêm địa chỉ mới
</button>
        <button class="btn btn-danger w-100 py-3 rounded-3 fw-bold shadow-sm" onclick="confirmAddressSelection()">
            XÁC NHẬN
        </button>
    </div>
</div>

<style>
    /* CSS Shopee Style */
    .address-item {
        transition: 0.2s;
        cursor: pointer;
    }
    .address-item:hover {
        background-color: #fcfcfc;
    }
    .address-item:last-child {
        border-bottom: none !important;
    }
    /* Màu đỏ Shopee huyền thoại */
    .badge-shopee {
        display: inline-block;
        border: 1px solid #943c2a;
        color: #9d3f2c;
        font-size: 11px;
        padding: 1px 6px;
        border-radius: 2px;
    }
    .btn-danger {
        background-color: #9b402d !important;
        border-color: #a84a38 !important;
    }
    .btn-outline-danger {
        color: #994332 !important;
        border-color: #94402f !important;
    }
    .btn-outline-danger:hover {
        background-color: #fff5f2 !important;
    }
    .custom-radio:checked {
        background-color: #af4f3c !important;
        border-color: #b04c38 !important;
    }
    .address-container {
        border: 1px solid #eee;
    }
</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function confirmAddressSelection() {
            // 1. Tìm cái radio đang được tích
            const selected = document.querySelector('input[name="selectedAddress"]:checked');
            
            if (selected) {
                const addressId = selected.value;

                // 2. Dùng AJAX để báo cho Controller lưu lại lựa chọn này
                $.ajax({
                    url: '@Url.Action("SetDefaultAddress", "Cart")', // Gọi hàm lưu ở Controller
                    type: 'POST',
                    data: { addressId: addressId },
                    success: function (response) {
                        if (response.success) {
                            // 3. Lưu xong mới hiện thông báo và chuyển trang
                            Swal.fire({
                                title: 'Đã chọn địa chỉ! 🥰',
                                text: 'Bé Phin đã cập nhật địa chỉ giao hàng cho Boss.',
                                icon: 'success',
                                confirmButtonColor: '#9b402d'
                            }).then(() => {
                                window.location.href = '@Url.Action("Checkout", "Cart")';
                            });
                        } else {
                            Swal.fire('Lỗi!', 'Không lưu được địa chỉ, Boss kiểm tra lại nhé!', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Kết nối server thất bại rồi Boss ơi!', 'error');
                    }
                });
            } else {
                Swal.fire('Boss ơi!', 'Vui lòng chọn một địa chỉ nhận hàng nhé!', 'warning');
            }
        }
        function showAddAddressModal() {
    Swal.fire({
        title: 'Thêm địa chỉ mới 🏠',
        html: `
            <input id="swal-name" class="swal2-input" placeholder="Họ và tên người nhận">
            <input id="swal-phone" class="swal2-input" placeholder="Số điện thoại">
            <textarea id="swal-address" class="swal2-textarea" placeholder="Địa chỉ chi tiết (Số nhà, tên đường...)"></textarea>
        `,
        focusConfirm: false,
        showCancelButton: true,
        confirmButtonText: 'Lưu địa chỉ',
        cancelButtonText: 'Hủy',
        confirmButtonColor: '#9b402d',
        preConfirm: () => {
            const name = document.getElementById('swal-name').value;
            const phone = document.getElementById('swal-phone').value;
            const address = document.getElementById('swal-address').value;
            if (!name || !phone || !address) {
                Swal.showValidationMessage(`Boss vui lòng điền đủ thông tin nha! 🥺`)
            }
            return { name: name, phone: phone, address: address }
        }
    // ... (Phần Swal.fire bên trên giữ nguyên)
    }).then((result) => {
        if (result.isConfirmed) {
            console.log("Đang gửi dữ liệu:", result.value); // Để Boss soi trong F12

            $.ajax({
                url: '/Cart/AddAddress', // Thử dùng đường dẫn trực tiếp nếu @Url.Action bị lỗi
                type: 'POST',
                data: {
                    receiverName: result.value.name,
                    phoneNumber: result.value.phone,
                    addressDetail: result.value.address
                },
                success: function (res) {
                    if (res.success) {
                        Swal.fire('Thành công! 🎉', 'Địa chỉ đã được lưu.', 'success')
                            .then(() => { location.reload(); });
                    } else {
                        // NÓ SẼ HIỆN LỖI TẠI ĐÂY NÈ BOSS
                        Swal.fire('Lỗi rồi Boss ơi! 🥺', res.message, 'error');
                    }
                },
                error: function (xhr) {
                    Swal.fire('Lỗi kết nối! ❌', 'Boss kiểm tra xem đã có thư viện jQuery chưa nhé!', 'error');
                }
            });
        }
    })
}
    </script>
}