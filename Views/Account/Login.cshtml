@{
    ViewData["Title"] = "Tài khoản - Coffee House";
    Layout = "_Layout"; 
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh; padding: 40px 0;">
    <div class="auth-card shadow-lg p-4 p-md-5 rounded-4 bg-white border" style="max-width: 480px; width: 100%;">
        
        <div id="loginFormArea">
            <div class="text-center mb-4">
                <h2 class="auth-title fw-bold" style="color: #3d2b1f;">Đăng nhập</h2>
                <p class="auth-subtitle text-muted small">Chào mừng Bạn quay lại với Coffee House ☕🥰</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2 small rounded-3 mb-3 border-0 shadow-sm">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                </div>
            }

            <form action="/Account/Login" method="post">
                <div class="mb-3">
                    <label class="small fw-bold ms-1 mb-1">Email</label>
                    <div class="input-group-auth">
                        <i class="far fa-envelope"></i>
                        <input type="email" name="Email" placeholder="boss@gmail.com" required>
                    </div>
                </div>
                
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1 px-1">
                        <label class="small fw-bold">Mật khẩu</label>
                        <a href="javascript:void(0)" onclick="featureDeveloping()" class="forgot-link small text-decoration-none">Quên mật khẩu?</a>
                    </div>
                    <div class="input-group-auth">
                        <i class="fas fa-lock"></i>
                        <input type="password" name="Password" id="loginPassInput" placeholder="********" required>
                        <i class="far fa-eye ms-auto toggle-pass" style="cursor:pointer"></i>
                    </div>
                </div>

                <div class="form-check mb-4 ms-1">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label small" for="rememberMe">Ghi nhớ đăng nhập</label>
                </div>

                <button type="submit" class="btn-auth-submit w-100 py-3 rounded-pill mb-3">ĐĂNG NHẬP NGAY 🚀</button>
            </form>

            <div class="text-center auth-switch-text small">
                Chưa có tài khoản? <span class="auth-switch-link fw-bold" style="color: #885a3b; cursor:pointer; text-decoration: underline;" onclick="toggleAuthForm('register')">Đăng ký tại đây</span>
            </div>
        </div>

        <div id="registerFormArea" style="display: none;">
            <div class="text-center mb-4">
                <h2 class="auth-title fw-bold" style="color: #3d2b1f;">Đăng ký tài khoản</h2>
                <p class="auth-subtitle text-muted small">Tạo tài khoản để trải nghiệm Coffee House ☕</p>
            </div>

            <form action="/Account/Register" method="post" id="registerForm">
                <div class="mb-3">
                    <label class="small fw-bold ms-1 mb-1">Họ và tên</label>
                    <div class="input-group-auth">
                        <i class="far fa-user"></i>
                        <input type="text" name="FullName" placeholder="Tên của bạn?" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="small fw-bold ms-1 mb-1">Email</label>
                    <div class="input-group-auth">
                        <i class="far fa-envelope"></i>
                        <input type="email" name="Email" placeholder="email@example.com" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="small fw-bold ms-1 mb-1">Số điện thoại</label>
                    <div class="input-group-auth">
                        <i class="fas fa-phone-alt"></i>
                        <input type="text" name="Phone" placeholder="09xx xxx xxx" required>
                    </div>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-md-6">
                        <label class="small fw-bold ms-1 mb-1">Mật khẩu</label>
                        <div class="input-group-auth px-2">
                            <input type="password" name="Password" id="regPass" placeholder="********" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="small fw-bold ms-1 mb-1">Xác nhận</label>
                        <div class="input-group-auth px-2">
                            <input type="password" name="ConfirmPassword" id="regConfirmPass" placeholder="********" required>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-auth-submit w-100 py-3 rounded-pill mb-3">TẠO TÀI KHOẢN NGAY ✨</button>
            </form>

            <div class="text-center auth-switch-text small">
                Đã có tài khoản? <span class="auth-switch-link fw-bold" style="color: #885a3b; cursor:pointer; text-decoration: underline;" onclick="toggleAuthForm('login')">Đăng nhập ngay</span>
            </div>
        </div>

        <div class="d-flex align-items-center my-4">
            <hr class="flex-grow-1 text-muted">
            <span class="px-3 text-muted small fw-bold">HOẶC</span>
            <hr class="flex-grow-1 text-muted">
        </div>

        <div class="d-flex justify-content-between gap-2 mb-4">
            <a href="/Account/ExternalLogin?provider=Google" class="social-btn w-50">
                <img src="https://img.icons8.com/color/48/google-logo.png" width="20" class="me-2"> Google
            </a>
            <a href="/Account/ExternalLogin?provider=Facebook" class="social-btn w-50">
                <img src="https://img.icons8.com/color/48/facebook-new.png" width="20" class="me-2"> Facebook
            </a>
        </div>

        <div class="text-center pt-3 border-top">
            <a href="/" class="back-home-link">
                <i class="fas fa-arrow-left me-2"></i>Quay lại trang chủ
            </a>
        </div>
    </div>
</div>

<style>
    .auth-card { border-radius: 25px !important; animation: fadeInUp 0.5s ease-out; transition: opacity 0.3s ease; }
    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    
    .input-group-auth {
        display: flex; align-items: center; background: #fdfaf7;
        border-radius: 50px; padding: 10px 20px; border: 1.5px solid #eee; transition: 0.3s;
    }
    .input-group-auth:focus-within { border-color: #885a3b; background: #fff; box-shadow: 0 0 0 4px rgba(136, 90, 59, 0.1); }
    .input-group-auth i { color: #885a3b; font-size: 1.1rem; }
    .input-group-auth input { border: none; background: transparent; margin-left: 12px; width: 100%; outline: none; font-size: 0.95rem; color: #3d2b1f; }
    
    .btn-auth-submit {
        background: linear-gradient(135deg, #3d2b1f 0%, #5c4033 100%);
        color: white; border: none; font-weight: 700; letter-spacing: 1px; transition: 0.3s;
        box-shadow: 0 8px 20px rgba(61, 43, 31, 0.2); cursor: pointer;
    }
    .btn-auth-submit:hover { transform: translateY(-3px); box-shadow: 0 12px 25px rgba(61, 43, 31, 0.3); color: white; }
    
    .social-btn {
        display: flex; align-items: center; justify-content: center; padding: 12px;
        border: 1.5px solid #eee; border-radius: 50px; text-decoration: none;
        color: #333; font-weight: 600; font-size: 0.9rem; transition: 0.3s;
    }
    .social-btn:hover { background: #f8f9fa; border-color: #ddd; }
    
    .back-home-link { color: #6c757d; text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: 0.3s; display: inline-flex; align-items: center; }
    .back-home-link:hover { color: #3d2b1f; transform: translateX(-5px); }
    .forgot-link { color: #885a3b; font-weight: 600; }
</style>

@section Scripts {
    <script>
        console.log(">>> Hệ thống Bé Phin Auth đã sẵn sàng phục vụ Boss Tâm!");

        // 1. Hàm chuyển đổi Form (Dùng querySelectorAll để tránh lỗi trùng ID trong Layout)
        window.toggleAuthForm = function(type) {
            console.log(">>> Đang chuyển đổi sang Form:", type);
            
            const loginAreas = document.querySelectorAll('#loginFormArea');
            const registerAreas = document.querySelectorAll('#registerFormArea');
            const authCard = document.querySelector('.auth-card');

            if (authCard) authCard.style.opacity = '0.5';

            setTimeout(() => {
                loginAreas.forEach(el => el.style.display = (type === 'register' ? 'none' : 'block'));
                registerAreas.forEach(el => el.style.display = (type === 'register' ? 'block' : 'none'));
                if (authCard) authCard.style.opacity = '1';
            }, 200);
        };

        // 2. Hiện/Ẩn mật khẩu cho tất cả các ô input pass
        document.querySelectorAll('.toggle-pass').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.parentElement.querySelector('input');
                if (input.type === 'password') {
                    input.type = 'text';
                    this.classList.replace('fa-eye', 'fa-eye-slash');
                } else {
                    input.type = 'password';
                    this.classList.replace('fa-eye-slash', 'fa-eye');
                }
            });
        });

        // 3. Kiểm tra mật khẩu khớp nhau (Đăng ký)
        document.getElementById('registerForm')?.addEventListener('submit', function(e) {
            const pass = document.getElementById('regPass').value;
            const confirm = document.getElementById('regConfirmPass').value;
            
            if (pass !== confirm) {
                e.preventDefault();
                Swal.fire({
                    title: 'Lỗi xác nhận!',
                    text: 'Mật khẩu nhập lại không khớp kìa Boss ơi! 🥺',
                    icon: 'error',
                    confirmButtonColor: '#3d2b1f'
                });
            }
        });

        window.featureDeveloping = function() {
            Swal.fire({
                title: 'Bé Phin nhắc nè! 🤖',
                text: 'Tính năng này đang pha chế, Boss đợi tí nhé!',
                icon: 'info',
                confirmButtonColor: '#3d2b1f'
            });
        };
    </script>
}