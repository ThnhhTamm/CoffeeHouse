@model IEnumerable<CoffeeHouseAdmin.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
        <div>
            <h2 class="fw-bold mb-1" style="color: #3d2b1f;">
                <i class="fas fa-box-open me-2"></i>Quản lý sản phẩm
            </h2>
            <p class="text-muted small">Có tổng cộng @Model.Count() món trong thực đơn.</p>
        </div>
        <button class="btn px-4 py-2 text-white shadow-sm" style="background: #3d2b1f; border-radius: 12px; font-weight: 600;">
            <i class="fas fa-plus me-2"></i>Thêm sản phẩm
        </button>
    </div>

    <div class="card border-0 shadow-sm p-3 mb-4" style="border-radius: 20px;">
        <form method="get" class="row g-2">
            <div class="col-md-9 position-relative">
                <i class="fas fa-search position-absolute text-muted" style="left: 20px; top: 15px;"></i>
                <input type="text" name="search" class="form-control border-0 bg-light py-2 ps-5" 
                       style="border-radius: 12px;" placeholder="Tìm kiếm sản phẩm theo tên hoặc danh mục...">
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold" 
                        style="background: #2a1d15; border-radius: 12px;">TÌM KIẾM</button>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 25px;">
        <table class="table table-hover align-middle mb-0 text-center">
            <thead>
                <tr style="background: #3d2b1f; color: #fff;">
                    <th class="py-3 ps-4 text-start">HÌNH ẢNH</th>
                    <th class="text-start">TÊN SẢN PHẨM</th>
                    <th>DANH MỤC</th>
                    <th>GIÁ</th>
                    <th>TỒN KHO</th>
                    <th>ĐỘ RANG</th>
                    <th>ĐỘ ĐẮNG</th>
                    <th class="pe-4">THAO TÁC</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @if (Model.Any()) {
                    @foreach (var p in Model) {
                        <tr>
                            <td class="ps-4 text-start">
                                <img src="@p.ImageUrl" class="rounded-3 shadow-sm" 
                                     style="width: 55px; height: 55px; object-fit: cover;" 
                                     onerror="this.src='https://via.placeholder.com/60'">
                            </td>
                            <td class="text-start fw-bold text-dark">@p.Name</td>
                            <td><span class="badge bg-light text-dark border px-3 py-2" style="border-radius: 8px;">@p.Category</span></td>
                            <td class="fw-bold">@p.Price.ToString("N0")đ</td>
                            <td class="text-success fw-bold">@p.Stock</td>
                            <td class="text-muted">@p.RoastLevel</td>
                            <td class="fw-bold" style="color: #6F4E37;">@p.BitternessLevel</td>
                            <td class="pe-4">
                                <div class="d-flex justify-content-center gap-2">
                                    <button class="btn btn-sm btn-light rounded-circle border shadow-sm text-primary btn-edit-trigger" 
                                            style="width: 35px; height: 35px;"
                                            data-id="@p.Id" 
                                            data-name="@p.Name" 
                                            data-price="@p.Price" 
                                            data-category="@p.Category" 
                                            data-stock="@p.Stock" 
                                            data-image="@p.ImageUrl">
                                        <i class="fas fa-pen"></i>
                                    </button>

                                    <a href="/Products/Delete/@p.Id" class="btn btn-sm btn-light rounded-circle border shadow-sm text-danger" 
                                       style="width: 35px; height: 35px;" onclick="return confirm('Xóa món này?')">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 25px; border: none;">
            <form action="/Products/Edit" method="post">
                <input type="hidden" name="Id" id="edit_id">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="fw-bold" style="color: #3d2b1f;">✏️ Cập nhật món</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="small fw-bold">TÊN MÓN</label>
                        <input type="text" name="Name" id="edit_name" class="form-control bg-light border-0 p-3" style="border-radius: 12px;" required>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="small fw-bold">GIÁ BÁN</label>
                            <input type="number" name="Price" id="edit_price" class="form-control bg-light border-0 p-3" style="border-radius: 12px;" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="small fw-bold">TỒN KHO</label>
                            <input type="number" name="Stock" id="edit_stock" class="form-control bg-light border-0 p-3" style="border-radius: 12px;">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="small fw-bold">DANH MỤC</label>
                        <select name="Category" id="edit_category" class="form-select bg-light border-0 p-3" style="border-radius: 12px;">
                            <option>Cà phê</option><option>Bánh & Món kèm</option><option>Trà túi lọc</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="small fw-bold">LINK HÌNH ẢNH</label>
                        <input type="text" name="ImageUrl" id="edit_image" class="form-control bg-light border-0 p-3" style="border-radius: 12px;">
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-dark w-100 py-3 fw-bold" style="background: #3d2b1f; border-radius: 15px;">LƯU THAY ĐỔI</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // JS Xử lý đổ dữ liệu từ nút bấm vào bảng sửa
        document.querySelectorAll('.btn-edit-trigger').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('edit_id').value = this.dataset.id;
                document.getElementById('edit_name').value = this.dataset.name;
                document.getElementById('edit_price').value = this.dataset.price;
                document.getElementById('edit_category').value = this.dataset.category;
                document.getElementById('edit_stock').value = this.dataset.stock;
                document.getElementById('edit_image').value = this.dataset.image;
                
                new bootstrap.Modal(document.getElementById('editModal')).show();
            });
        });
    </script>
}