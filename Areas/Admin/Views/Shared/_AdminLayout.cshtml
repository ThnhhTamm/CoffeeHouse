<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coffee House Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        :root { --sidebar-bg: #3d2b1f; --brand-bg: #513c2c; --active-bg: #fdf0d5; --text-kem: #fdf0d5; }
        body { background: #f8f9fa; font-family: 'Inter', sans-serif; margin: 0; }
        
        .sidebar { 
            width: 280px; background: var(--sidebar-bg); height: 100vh; position: fixed; 
            top: 0; left: 0; padding: 25px 20px; z-index: 1000; display: flex; flex-direction: column;
        }
        .brand-section {
            background: var(--brand-bg); padding: 15px; border-radius: 20px;
            display: flex; align-items: center; gap: 15px; margin-bottom: 35px;
            text-decoration: none !important; color: var(--text-kem);
        }
        .nav-link {
            display: flex; align-items: center; gap: 15px; padding: 12px 20px;
            text-decoration: none !important; color: var(--text-kem) !important;
            font-weight: 600; border-radius: 15px; transition: 0.3s; margin-bottom: 8px;
        }
        .nav-link:hover { background: rgba(253, 240, 213, 0.1); }
        
        /*/* Hiệu ứng sáng nút chuẩn gu Boss Tâm */
.nav-link.active { 
    background: var(--active-bg) !important; 
    color: var(--sidebar-bg) !important; 
    font-weight: 700;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1); /* Thêm chút bóng cho xịn */
}

        .main-content { margin-left: 280px; padding: 40px; width: calc(100% - 280px); min-height: 100vh; }
        .divider { border-top: 1px solid rgba(253, 240, 213, 0.1); margin: 20px 0; }
       
    /* Hiệu ứng khi di chuột qua các mục menu */
    .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        transition: 0.3s;
    }
    </style>

@* --- THÊM DÒNG NÀY VÀO ĐÂY NÈ BOSS! --- *@
    @await RenderSectionAsync("Styles", required: false)

</head>
<body>
    <div class="sidebar">
        <a href="/" class="brand-section">
            <i class="fas fa-th-large fa-2x" style="color: #d4a373;"></i>
            <div><h5 class="m-0 fw-bold">Coffee House</h5><small class="opacity-75">Admin Dashboard</small></div>
        </a>

        <div class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" 
               asp-controller="Home" asp-action="Index"><i class="fas fa-th-large"></i> Dashboard</a>
            
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")" 
               asp-controller="Products" asp-action="Index"><i class="fas fa-coffee"></i> Sản phẩm</a>
            
            <a class="nav-link" asp-controller="Orders" asp-action="Index"><i class="fas fa-shopping-cart"></i> Đơn hàng</a>
            
<a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Promotions" ? "active" : "")" 
   asp-area="Admin" asp-controller="Promotions" asp-action="Index">
    <i class="fas fa-tags"></i> Khuyến mãi
</a>

<a class="nav-link" asp-controller="Customers" asp-action="Index">
    <i class="fas fa-users"></i> Khách hàng
</a>            
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tables" ? "active" : "")" 
               asp-controller="Tables" asp-action="Index"><i class="fas fa-chair"></i> Quản lý bàn</a>
            
            <a class="nav-link" asp-controller="ChatLogs" asp-action="Index"><i class="fas fa-robot"></i> AI Chat Logs</a>
        </div>
        <li class="nav-item">
    <a class="nav-link text-white" href="/Admin/Reviews">
        <i class="fas fa-star me-2 text-warning"></i> Quản lý đánh giá
    </a>
</li>

        <div class="mt-auto">
            <div class="divider"></div>
<a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
    <i class="fas fa-arrow-left"></i> Quay lại trang chủ
</a>            <a class="nav-link text-danger" href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>