</script>

@section Scripts {
    @* --- BƯỚC 1: CHUẨN BỊ DỮ LIỆU C# (Viết riêng để không bị lỗi Method Group) --- *@
    @{
        var tenHienThi = Context.Session.GetString("UserName") ?? "Khach_Vang_Lai"; 
        var safeKey = tenHienThi.Replace("@", "_").Replace(".", "_").Replace(" ", "_");
        var menuJsonData = "[]";

        if (Model != null && Model.Any())
        {
            var simplified = Model.Select(p => new {
                p.Name,
                p.Price,
                p.Category,
                Description = p.Description ?? p.FlavorProfile ?? "Thơm ngon"
            }).ToList();
            menuJsonData = Newtonsoft.Json.JsonConvert.SerializeObject(simplified);
        }
    }

    <script>
        // ========================================================
        // --- 1. BIẾN TOÀN CỤC (CHÌA KHÓA TỔNG - DÙNG TOÀN TRANG) ---
        // ========================================================
        const currentUser = '@(Context.Session.GetString("UserName") ?? "Khach_Vang_Lai")';
        const CART_KEY = 'coffee_cart_' + currentUser;
        const STORAGE_KEY = 'phin_chat_history_@(safeKey)';
        
        let currentBasePrice = 0;
        let menuString = "Danh sách menu thực tế của quán Coffee House:\n";

        // ========================================================
        // --- 2. LOGIC MODAL CHI TIẾT SẢN PHẨM ---
        // ========================================================
        
        // Hàm mở Modal và xử lý ẩn/hiện tùy chọn theo loại món
        function openProductDetail(name, price, img, desc, star, category) {
            console.log(">>> Bé Phin đang mở món:", name, "| Loại:", category);
            currentBasePrice = price;

            const modalImg = document.getElementById('modalImg');
            if (modalImg) { modalImg.src = img; }

            document.getElementById('modalName').innerText = name;
            document.getElementById('modalFlavor').innerText = desc;
            document.getElementById('modalBasePrice').value = price;
            // Reset số lượng về 1 mỗi khi mở món mới
            document.getElementById('modalQty').value = 1;

            const starElement = document.getElementById('modalStar');
            if (starElement) {
                starElement.innerHTML = `⭐ ${star}/5`;
            }

            document.getElementById('modalDisplayPrice').innerText = price.toLocaleString() + "đ";

            // LOGIC "MẮT THẦN" - XỬ LÝ ẨN/HIỆN (BÁNH THÌ DẸP TOPPING)
            const iceBox = document.getElementById('iceOptionSection');
            const sugarBox = document.getElementById('sugarOptionSection');
            const toppingBox = document.getElementById('toppingOptionSection');
            const catName = category ? category.toLowerCase().trim() : "";

            if (catName.includes("bánh") || catName.includes("kèm")) {
                if (iceBox) iceBox.style.setProperty('display', 'none', 'important');
                if (sugarBox) sugarBox.style.setProperty('display', 'none', 'important');
                if (toppingBox) toppingBox.style.setProperty('display', 'none', 'important');
            } else {
                if (iceBox) iceBox.style.setProperty('display', 'block', 'important');
                if (sugarBox) sugarBox.style.setProperty('display', 'block', 'important');
                if (toppingBox) toppingBox.style.setProperty('display', 'block', 'important');
            }

            // RESET FORM VỀ TRẠNG THÁI BAN ĐẦU
            document.querySelectorAll('.topping-item').forEach(el => el.checked = false);
            if (document.getElementById('ice100')) document.getElementById('ice100').checked = true;
            if (document.getElementById('sug100')) document.getElementById('sug100').checked = true;

            calculateTotalPrice();

            // MỞ MODAL (Dùng Bootstrap API)
            const myModal = new bootstrap.Modal(document.getElementById('productModal'));
            myModal.show();
        }

        // Hàm tăng giảm số lượng trên Modal
        function changeQty(delta) {
            let qtyInput = document.getElementById('modalQty');
            let currentQty = parseInt(qtyInput.value) || 1;
            let newQty = currentQty + delta;
            if (newQty < 1) newQty = 1; 
            qtyInput.value = newQty;
            calculateTotalPrice(); // Tính lại tiền ngay
        }

        // Hàm tính tiền động khi khách chọn số lượng hoặc Topping
        function calculateTotalPrice() {
            const basePrice = parseInt(document.getElementById('modalBasePrice').value) || 0;
            const qty = parseInt(document.getElementById('modalQty').value) || 1;
            
            let toppingTotal = 0;
            document.querySelectorAll('.topping-item:checked').forEach(item => {
                toppingTotal += parseInt(item.getAttribute('data-price')) || 0;
            });

            const finalTotal = (basePrice + toppingTotal) * qty;
            
            const totalBtn = document.getElementById('modalTotalBtn');
            if (totalBtn) {
                totalBtn.innerText = finalTotal.toLocaleString('vi-VN') + "đ";
            }
        }

        // HÀM XÁC NHẬN THÊM VÀO GIỎ (ĐÃ FIX LỖI SỐ LƯỢNG VÀ BIẾN CART_KEY)
        function confirmAddToCart() {
            try {
                const tableId = '@Context.Session.GetString("SittingTable")';

                // --- ĐIỀU KIỆN CHẶN ĐĂNG NHẬP ---
                if (currentUser === "Khach_Vang_Lai" && (tableId === '' || tableId === null)) {
                    Swal.fire({
                        title: 'Bạn ơi, từ từ đã! ✋',
                        text: "Bạn đăng nhập để thêm vào giỏ hàng, hoặc quét mã QR tại bàn để gọi món nhé!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3d2b1f',
                        confirmButtonText: 'Đi đăng nhập ngay 🥰',
                        cancelButtonText: 'Để sau'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/Account/Login'; 
                        }
                    });
                    return; 
                }

                const name = document.getElementById('modalName').innerText;
                const priceBtn = document.getElementById('modalTotalBtn');
                const finalPrice = parseInt(priceBtn.innerText.replace(/\./g, '').replace('đ', '')) || 0;
                
                // LẤY ĐÚNG SỐ LƯỢNG THỰC TẾ (FIX LỖI CHỈ HIỆN 1)
                const selectedQty = parseInt(document.getElementById('modalQty').value) || 1;

                const ice = document.querySelector('input[name="ice"]:checked')?.nextElementSibling.innerText || "100% đá";
                const sugar = document.querySelector('input[name="sugar"]:checked')?.nextElementSibling.innerText || "100% đường";

                let toppings = [];
                document.querySelectorAll('.topping-item:checked').forEach(tp => {
                    toppings.push(tp.nextElementSibling.innerText);
                });
                const toppingList = toppings.join(", ");

                const cartItem = {
                    name: name,
                    price: finalPrice / selectedQty, // Lưu đơn giá 1 ly để tính toán ở trang giỏ hàng
                    image: document.getElementById('modalImg').getAttribute('src'),
                    options: `${ice}, ${sugar}`,
                    toppings: toppingList,
                    quantity: selectedQty 
                };

                // DÙNG BIẾN TOÀN CỤC CART_KEY
                let cart = JSON.parse(sessionStorage.getItem(CART_KEY)) || [];

                const existingItem = cart.find(item => 
                    item.name === cartItem.name && 
                    item.options === cartItem.options && 
                    item.toppings === cartItem.toppings
                );

                if (existingItem) {
                    // Nếu đã có, cộng thêm số lượng khách mới chọn
                    existingItem.quantity += selectedQty;
                } else {
                    cart.push(cartItem);
                }

                sessionStorage.setItem(CART_KEY, JSON.stringify(cart));

                // Cập nhật chấm đỏ giỏ hàng
                if (typeof updateCartBadge === 'function') updateCartBadge();

                // Đóng Modal
                const modalEl = document.getElementById('productModal');
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) modalInstance.hide();

                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 2000,
                    icon: 'success',
                    title: `Đã thêm ${selectedQty} món vào giỏ! 🥰`
                });
            } catch (e) {
                console.error("Lỗi thêm vào giỏ:", e);
            }
        }

        // ========================================================
        // --- 3. LOGIC CHATBOT BÉ PHIN AI (GIỮ NGUYÊN) ---
        // ========================================================
        document.addEventListener('DOMContentLoaded', function () {
            const widget = document.getElementById('chatWidget');
            const toggleBtn = document.getElementById('chatbotToggleBtn');
            const chatMessages = document.getElementById('chatMessages');
            const chatInput = document.getElementById('chatInput');
            const sendBtn = document.getElementById('sendChatBtn');
            const clearBtn = document.getElementById('clearChatBtn');
            const storage = (currentUser === 'Khach_Vang_Lai') ? sessionStorage : localStorage;

            // --- NẠP MENU VÀO menuString ---
            try {
                const rawData = @Html.Raw(menuJsonData);
                if (Array.isArray(rawData)) {
                    rawData.forEach(p => {
                        menuString += "- " + p.Name + " (" + p.Category + "): " + p.Price.toLocaleString() + "đ. HD: " + p.Description + "\n";
                    });
                }
            } catch (e) {
                console.error("Bé Phin: Lỗi nạp menu!", e);
            }
            console.log("Bé Phin đã học thuộc menu mới nhất:", menuString);

            const forceScroll = () => {
                if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
            };

            // Mở/Đóng chat
            if (toggleBtn) {
                toggleBtn.onclick = () => {
                    widget.classList.toggle('d-none');
                    if (!widget.classList.contains('d-none')) setTimeout(forceScroll, 50);
                };
            }

            if (document.getElementById('closeChatBtn')) {
                document.getElementById('closeChatBtn').onclick = () => widget.classList.add('d-none');
            }

            // Gửi tin nhắn
            async function handleSend() {
                const text = chatInput.value.trim();
                if (!text) return;

                // --- 1. VŨ KHÍ CHỐNG CHÀO RƯỜM RÀ ---
                const userMessages = chatMessages.querySelectorAll('.text-end').length;
                let currentInstruction = menuString;
                if (userMessages > 0) {
                    currentInstruction += "\nLƯU Ý: Trả lời ngắn gọn, KHÔNG chào lại 'Bé Phin xin chào'.";
                }

                chatMessages.insertAdjacentHTML('beforeend', `<div class="text-end mb-2"><span class="p-2 text-white rounded shadow-sm d-inline-block" style="background:#3d2b1f;">${text}</span></div>`);
                chatInput.value = '';
                
                const loadId = "load-" + Date.now();
                chatMessages.insertAdjacentHTML('beforeend', `<div id="${loadId}" class="mb-2 small text-muted">Bé Phin đang gõ... 💭</div>`);
                forceScroll();

                try {
                    const res = await fetch('/Chat/AskGemini', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: text, menu: currentInstruction })
                    });
                    const data = await res.json();
                    if (document.getElementById(loadId)) document.getElementById(loadId).remove();

                    let rawReply = data.reply;

                    // --- 2. BỘ LỌC GỌI MÓN ---
                    const orderRegex = /\[ORDER:\s*(.*?)\s*\|\s*(.*?)\]/gi;
                    const matches = [...rawReply.matchAll(orderRegex)];

                    if (matches.length > 0) {
                        matches.forEach(match => {
                            const itemName = match[1].trim();
                            const itemPrice = match[2].trim();
                            if (typeof addFromAI === 'function') {
                                addFromAI(itemName, itemPrice);
                            }
                        });
                    }

                    // --- 3. BỘ LỌC ĐIỀU HƯỚNG ---
                    if (/\[CHECKOUT\]/i.test(rawReply)) {
                        const tableId = '@Context.Session.GetString("SittingTable")';
                        const urlGioHang = '@Url.Action("Index", "Cart")';
                        const urlThanhToan = '@Url.Action("Checkout", "Cart")';

                        Swal.fire({
                            title: 'Bé Phin đang dẫn đường... 🐾',
                            text: (tableId && tableId !== "") ? 'Mời Bạn xem lại giỏ hàng để gọi món tại bàn nhé!' : 'Dẫn Bạn đi thanh toán đơn hàng Online ngay đây!',
                            icon: 'success',
                            timer: 2000,
                            showConfirmButton: false,
                            willClose: () => {
                                if (tableId && tableId !== "") {
                                    window.location.href = `${urlGioHang}?tableId=${tableId}`;
                                } else {
                                    window.location.href = urlThanhToan;
                                }
                            }
                        });
                    }

                    // --- 4. LÀM SẠCH VÀ HIỂN THỊ ---
                    let cleanReply = rawReply.replace(/\[.*?\]/g, '')
                                             .replace(/\n/g, '<br>')
                                             .replace(/Bé Phin/g, '<b>Bé Phin</b>');

                    chatMessages.insertAdjacentHTML('beforeend', `<div class="mb-2"><span class="p-2 bg-white border rounded shadow-sm d-inline-block">${cleanReply}</span></div>`);
                    storage.setItem(STORAGE_KEY, chatMessages.innerHTML);
                    forceScroll();

                } catch (err) {
                    if(document.getElementById(loadId)) document.getElementById(loadId).innerText = "Lỗi rồi Boss ơi... 🥺";
                    console.error("Lỗi Chatbot:", err);
                }
            }

            if (sendBtn) sendBtn.onclick = handleSend;
            if (chatInput) chatInput.onkeypress = (e) => { if (e.key === 'Enter') handleSend(); };

            // Logic AI gọi món (addFromAI)
            window.addFromAI = function(name, priceStr) {
                const price = parseInt(priceStr.replace(/\./g, '').replace('đ', '').trim()) || 0;
                const rawData = @Html.Raw(menuJsonData) || []; 

                const aiSearchName = name.toLowerCase().trim().normalize('NFC');
                const productInfo = rawData.find(p => {
                    const menuName = (p.Name || p.name || "").toLowerCase().trim().normalize('NFC');
                    return menuName.includes(aiSearchName) || aiSearchName.includes(menuName);
                });

                let anhMoneAn = "/img/default-coffee.png";
                if (productInfo) {
                    let path = productInfo.Image || productInfo.image || productInfo.HinhAnh;
                    if (path) {
                        anhMoneAn = (path.startsWith('/') || path.startsWith('http')) ? path : "/img/" + path;
                    }
                }

                let cart = JSON.parse(sessionStorage.getItem(CART_KEY)) || [];
                const cartItem = {
                    name: productInfo ? productInfo.Name : name,
                    price: price,
                    image: anhMoneAn,
                    options: "AI đặt hộ",
                    quantity: 1
                };

                const existingIndex = cart.findIndex(i => i.name === cartItem.name);
                if (existingIndex > -1) {
                    cart[existingIndex].quantity += 1;
                } else {
                    cart.push(cartItem);
                }

                sessionStorage.setItem(CART_KEY, JSON.stringify(cart));
                if (typeof updateCartBadge === 'function') updateCartBadge();
            };

            // Xóa lịch sử chat
            if (clearBtn) {
                clearBtn.onclick = () => {
                    Swal.fire({
                        title: 'Xóa sạch kỷ niệm sao Bạn? 🥺',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3d2b1f',
                        confirmButtonText: 'Xóa đi!',
                    }).then((result) => {
                        if (result.isConfirmed) {
                            storage.removeItem(STORAGE_KEY);
                            chatMessages.innerHTML = `<div class="mb-2"><span class="p-2 bg-white rounded shadow-sm d-inline-block border">Ú oà! <b style="color:#3d2b1f">Bé Phin</b> xuất hiện rồi đây! Đừng ngần ngại hỏi em nha? ☕️🥰☕</span></div>`;
                        }
                    });
                };
            }

            // Load lịch sử chat
            const history = storage.getItem(STORAGE_KEY);
            if (history && history.trim() !== "") {
                chatMessages.innerHTML = history;
                setTimeout(forceScroll, 100);
            } else {
                chatMessages.innerHTML = `
                    <div class="mb-2">
                        <span class="p-2 bg-white rounded shadow-sm d-inline-block border" style="max-width: 85%;">
                            Ú oà! <b style="color:#3d2b1f">Bé Phin</b> đây! 
                            Hôm nay Boss muốn thử món gì mới của quán mình không ạ? 🥰☕
                        </span>
                    </div>`;
            }

            // Thông báo quét mã bàn
            const urlParams = new URLSearchParams(window.location.search);
            const tableIdUrl = urlParams.get('tableId');
            if (tableIdUrl) {
                Swal.fire({
                    title: 'Xin chào Bạn yêu! 👋',
                    html: `Bé Phin đã sẵn sàng phục vụ tại <b>Bàn ${tableIdUrl}</b>.<br>Mời Bạn yêu thong thả chọn món nhé!`,
                    icon: 'success',
                    confirmButtonColor: '#3d2b1f',
                    confirmButtonText: 'Bắt đầu gọi món 🥰'
                });
            }
        });
    </script>
}